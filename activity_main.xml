<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#030712"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SF EMPIRE · OFFLINE"
            android:textColor="#60C8F5"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="우주 제국 GM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="25sp"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="로컬 AI 초기화 중…"
            android:textColor="#8197AD"
            android:textSize="12sp"
            android:paddingTop="4dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="10dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/select_model" android:layout_width="wrap_content" android:layout_height="44dp" android:text="모델" android:textAllCaps="false" />
            <Button android:id="@+id/save_game" android:layout_width="wrap_content" android:layout_height="44dp" android:text="저장" android:textAllCaps="false" />
            <Button android:id="@+id/load_game" android:layout_width="wrap_content" android:layout_height="44dp" android:text="불러오기" android:textAllCaps="false" />
            <Button android:id="@+id/new_game" android:layout_width="wrap_content" android:layout_height="44dp" android:text="새 게임" android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="#050B16">

        <EditText
            android:id="@+id/user_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="54dp"
            android:maxLines="5"
            android:padding="14dp"
            android:hint="행동이나 명령을 입력하세요…"
            android:textColor="#F4F8FF"
            android:textColorHint="#6F8399"
            android:background="@drawable/input_background"
            android:inputType="textCapSentences|textMultiLine" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/outline_send_24"
            android:contentDescription="전송" />
    </LinearLayout>
</LinearLayout>
